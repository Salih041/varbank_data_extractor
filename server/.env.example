GROQ_API_KEY=
TAVILY_API_KEY=
# En az 12 karakter. Bu anahtarı yalnızca eklentiyi kullanmasını istediğiniz kişilere verin.
ACCESS_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Groq ücretsiz planı dakikada 8.000 token verir; ücretli planda yükseltilebilir.
MAX_HISTORY_TOKENS=3000
ALLOWED_ORIGIN=chrome-extension://<extension-id>
# Yalnızca yayında (Neon Postgres). Boşsa yerelde checkpoints.db (SQLite) kullanılır.
# DATABASE_URL=postgresql://kullanici:sifre@ep-xxx.aws.neon.tech/neondb?sslmode=require
# Cloud Run'da Dockerfile bunu true yapar; yerelde false kalmalı.
# TRUST_PROXY_HEADERS=false
